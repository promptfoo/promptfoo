{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reason", "issues"],
  "properties": {
    "status": { "enum": ["valid", "invalid", "inconclusive"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "issues": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "caller_quote", "reason"],
        "properties": {
          "kind": { "enum": ["role", "closing", "scenario"] },
          "caller_quote": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 3000 }
        }
      }
    }
  }
}
