# Git and Docker metadata
.git
.gitignore
Dockerfile
.dockerignore

# Installed and built inside the image. Test fixtures keep their vendored packages.
**/node_modules
!test/__fixtures__/mock-packages/node_modules
dist

# Local files that must not reach a build layer
**/.env*
**/*.log
**/.DS_Store
**/*.sw[op]
.aider*
.worktrees
scratch
venv
*.sqlite

# The server bundles the OpenAPI document from the docs workspace.
examples
site
!site/static/openapi.json
